                <div class="cat-icon">💄</div><div class="cat-name">كوزمتك</div>
            </div>
            <div class="cat-card" onclick="openCategoryStores('المطاعم', '🍔')">
                <div class="cat-icon">🍔</div><div class="cat-name">مطاعم</div>
            </div>
            <div class="cat-card" onclick="openCategoryStores('الخضروات والفواكه', '🥦')">
