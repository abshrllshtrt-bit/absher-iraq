    <script>
        let cart = [];
        let activeOrders = [];

        let currentSlide = 0;
        const slider = document.getElementById('slider');
        setInterval(() => {
            currentSlide = (currentSlide + 1) % 3;
            slider.style.transform = `translateX(${currentSlide * 33.33}%)`;
        }, 3500);

        function switchPage(pageId) {
            document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));

            const activePage = document.getElementById(pageId);
            if(activePage) activePage.classList.add('active');

            if (pageId === 'home-page') document.getElementById('nav-home')?.classList.add('active');
            if (pageId === 'cart-page') { document.getElementById('nav-cart')?.classList.add('active'); renderCart(); }
            if (pageId === 'orders-page') { document.getElementById('nav-orders')?.classList.add('active'); fetchOrdersFromFirebase(); }
            if (pageId === 'auth-page') document.getElementById('nav-auth')?.classList.add('active');
            if (pageId === 'location-page') initMap();
            window.scrollTo(0,0);
        }

        function openCategoryStores(categoryName, icon) {
            document.getElementById('stores-page-title').innerText = `${icon} متاجر قسم ${categoryName}`;
            const container = document.getElementById('stores-container');
            container.innerHTML = `
                <div class="store-card" onclick="openStoreProducts('متجر ${categoryName} الرئيسي', '${icon}')">
                    <div class="store-avatar">${icon}</div>
                    <div class="store-info">
                        <div class="store-name">متجر ${categoryName} الرئيسي</div>
                        <div class="store-desc">توصيل سريع خلال 30 دقيقة</div>
                        <div class="store-rating">⭐ 4.9</div>
                    </div>
                </div>
            `;
            switchPage('stores-page');
        }

        function openStoreProducts(storeName, icon) {
            document.getElementById('store-title').innerText = `منتجات ${storeName}`;
            const container = document.getElementById('products-container');
            container.innerHTML = '';

            for (let i = 1; i <= 4; i++) {
                let price = i * 3000 + 2000;
                container.innerHTML += `
                    <div class="product-card">
                        <div class="product-img">${icon}</div>
                        <strong>منتج رقم ${i}</strong>
                        <div style="color: var(--primary-theme); font-weight: bold; margin-top: 4px;">${price.toLocaleString()} د.ع</div>
                        <button class="btn-primary" style="margin-top:6px; padding:0.4rem;" onclick="addToCart('منتج رقم ${i} (${storeName})', ${price}, '${icon}')">إضافة للسلة 🛒</button>
                    </div>
                `;
            }
            switchPage('store-products-page');
        }

        function addToCart(name, price, icon) {
            cart.push({ name, price, icon });
            document.getElementById('cart-badge').innerText = cart.length;
            alert(`تمت إضافة "${name}" إلى سلة المشتريات بنجاح!`);
        }

        function renderCart() {
            const container = document.getElementById('cart-items-container');
            const summaryBox = document.getElementById('cart-summary');
            container.innerHTML = '';

            if (cart.length === 0) {
                container.innerHTML = `<div style="text-align:center; color:var(--gray-text); margin-top:2rem;">سلة المشتريات فارغة حالياً</div>`;
                summaryBox.style.display = 'none';
                return;
            }

            summaryBox.style.display = 'block';
            let total = 0;

            cart.forEach((item, index) => {
                total += item.price;
                container.innerHTML += `
                    <div class="cart-item">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <span style="font-size:1.5rem;">${item.icon}</span>
                            <div>
                                <strong style="font-size:0.9rem;">${item.name}</strong>
                                <div style="color:var(--primary-theme); font-size:0.8rem; font-weight:bold;">${item.price.toLocaleString()} د.ع</div>
                            </div>
                        </div>
                        <button style="background:#ffdddd; color:red; border:none; padding:5px 10px; border-radius:8px; cursor:pointer;" onclick="removeFromCart(${index})">حذف</button>
                    </div>
                `;
            });
            document.getEle
