        .nav-item { text-align: center; color: var(--gray-text); font-size: 0.75rem; text-decoration: none; cursor: pointer; flex: 1; font-weight: 600; }
        .nav-item.active { color: var(--primary-theme); font-weight: 800; }
        .nav-icon { font-size: 1.3rem; display: block; margin-bottom: 2px; }
